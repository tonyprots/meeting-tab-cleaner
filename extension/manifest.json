{
  "manifest_version": 3,
  "default_locale": "ru",
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "3.2.0",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "111",
  "permissions": ["alarms", "storage", "scripting"],
  "host_permissions": [
    "https://telemost.yandex.ru/j/*",
    "https://telemost.360.yandex.ru/j/*",
    "https://*.zoom.us/j/*",
    "https://*.zoom.us/s/*",
    "https://*.zoom.us/wc/*",
    "https://*.zoomgov.com/j/*",
    "https://*.zoomgov.com/s/*",
    "https://*.zoomgov.com/wc/*",
    "https://teams.microsoft.com/l/meetup-join/*",
    "https://teams.microsoft.com/meet/*",
    "https://teams.microsoft.com/dl/launcher/*",
    "https://teams.live.com/l/meetup-join/*",
    "https://teams.live.com/meet/*",
    "https://teams.live.com/dl/launcher/*",
    "https://*.webex.com/*/j.php*",
    "https://*.webex.com/webappng/sites/*/meeting/download/*",
    "https://*.webex.com/wbxmjs/joinservice/sites/*/meeting/download/*",
    "https://*.gotomeeting.com/join/*",
    "https://*.goto.com/join/*",
    "https://meet.goto.com/*"
  ],
  "optional_host_permissions": [
    "https://meet.google.com/*",
    "https://*.ktalk.ru/*",
    "https://*.mts-link.ru/*",
    "https://*.webinar.ru/*",
    "https://jazz.sber.ru/*",
    "https://meet.jit.si/*",
    "https://8x8.vc/*",
    "https://*.whereby.com/*",
    "https://app.chime.aws/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://telemost.yandex.ru/j/*",
        "https://telemost.360.yandex.ru/j/*",
        "https://*.zoom.us/j/*",
        "https://*.zoom.us/s/*",
        "https://*.zoom.us/wc/*",
        "https://*.zoomgov.com/j/*",
        "https://*.zoomgov.com/s/*",
        "https://*.zoomgov.com/wc/*",
        "https://teams.microsoft.com/l/meetup-join/*",
        "https://teams.microsoft.com/meet/*",
        "https://teams.microsoft.com/dl/launcher/*",
        "https://teams.live.com/l/meetup-join/*",
        "https://teams.live.com/meet/*",
        "https://teams.live.com/dl/launcher/*",
        "https://*.webex.com/*/j.php*",
        "https://*.webex.com/webappng/sites/*/meeting/download/*",
        "https://*.webex.com/wbxmjs/joinservice/sites/*/meeting/download/*",
        "https://*.gotomeeting.com/join/*",
        "https://*.goto.com/join/*",
        "https://meet.goto.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://telemost.yandex.ru/j/*",
        "https://telemost.360.yandex.ru/j/*",
        "https://*.zoom.us/j/*",
        "https://*.zoom.us/s/*",
        "https://*.zoom.us/wc/*",
        "https://*.zoomgov.com/j/*",
        "https://*.zoomgov.com/s/*",
        "https://*.zoomgov.com/wc/*",
        "https://teams.microsoft.com/l/meetup-join/*",
        "https://teams.microsoft.com/meet/*",
        "https://teams.microsoft.com/dl/launcher/*",
        "https://teams.live.com/l/meetup-join/*",
        "https://teams.live.com/meet/*",
        "https://teams.live.com/dl/launcher/*",
        "https://*.webex.com/*/j.php*",
        "https://*.webex.com/webappng/sites/*/meeting/download/*",
        "https://*.webex.com/wbxmjs/joinservice/sites/*/meeting/download/*",
        "https://*.gotomeeting.com/join/*",
        "https://*.goto.com/join/*",
        "https://meet.goto.com/*"
      ],
      "js": ["rtc-probe.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
